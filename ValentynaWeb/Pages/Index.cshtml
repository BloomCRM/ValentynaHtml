@page
@model IndexModel
@{
    ViewData["Title"] = "Валентина — перукарня";
}

<header class="hero-background" id="home">
  <!-- Хедер -->
  <div class="header">
    <div class="logo-container">
      <p class="logo"><span data-translate="logo-main">ВАЛЕНТИНА</span> <span class="logo-span" data-translate="logo-sub">перукарня</span></p>
      <button type="button" class="menu-burger" id="burger-btn">
        <svg class="menu-burger-icon">
          <use href="#menu-burger"></use>
        </svg>
      </button>

      <div class="mobile-menu" id="mobile-menu">
        <button type="button" class="close-button" id="close-btn">
          <svg class="menu-close-icon">
            <use href="#menu-close"></use>
          </svg>
        </button>
        <div class="mobile-menu-container">
          <p class="logo-mobile">
            <span data-translate="logo-main">ВАЛЕНТИНА</span> <span class="logo-span" data-translate="logo-sub">перукарня</span>
          </p>
          <div class="mobile-language-switch">
            <button class="lang-btn active" data-lang="ua">UA</button>
            <button class="lang-btn" data-lang="en">EN</button>
          </div>
          <nav class="mobile-nav">
            <ul class="mobile-nav-list">
              <li><a href="#home" class="mobile-nav-link" data-translate="nav-home">Головна</a></li>
              <li><a href="#services" class="mobile-nav-link" data-translate="nav-services">Послуги</a></li>
              <li><a href="#about" class="mobile-nav-link" data-translate="nav-about">Про нас</a></li>
              <li><a href="#price" class="mobile-nav-link" data-translate="nav-price">Прайс</a></li>
              <li><a href="#gallery" class="mobile-nav-link" data-translate="nav-gallery">Галерея</a></li>
              <li><a href="#booking" class="mobile-nav-link" data-translate="nav-contacts">Контакти</a></li>
            </ul>
          </nav>
          <a href="@Model.BookingUrl" class="mobile-book-btn" data-translate="hero-book">Записатися</a>
          <div class="mobile-contacts">
            <div class="mobile-contacts-img">
              <svg class="mobile-phone-icon">
                <use href="#phone-modal"></use>
              </svg>
            </div>
            <a href="tel:@Model.Salon.Phone" class="mobile-phone">@Model.PhoneDisplay</a>
          </div>
          <div class="footer-link-container">
            <div class="footer-link-img-container">
              <a href="https://www.instagram.com/valentyna_perukarnia/" target="_blank" class="footer-svg-link">
                <svg class="footer-link-icon"><use href="#instagram"></use></svg>
              </a>
            </div>
            <div class="footer-link-img-container">
              <a href="https://t.me/valentyna_perukarnia" target="_blank" class="footer-svg-link">
                <svg class="footer-link-icon"><use href="#telegram2"></use></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="nav-container">
      <div class="nav-container-inner">
        <nav class="nav">
          <ul class="nav-list">
            <li><a href="#home" class="nav-link" data-translate="nav-home">Головна</a></li>
            <li><a href="#about" class="nav-link" data-translate="nav-about">Про нас</a></li>
            <li><a href="#price" class="nav-link" data-translate="nav-price">Прайс</a></li>
            <li><a href="#gallery" class="nav-link" data-translate="nav-gallery">Галерея</a></li>
            <li><a href="#booking" class="nav-link" data-translate="nav-contacts">Контакти</a></li>
          </ul>
        </nav>
      </div>
      <div class="nav-actions">
        <div class="language-switch">
          <button class="lang-btn active" data-lang="ua">UA</button>
          <button class="lang-btn" data-lang="en">EN</button>
        </div>
        <a href="https://t.me/valentyna_perukarnia" target="_blank" rel="noopener noreferrer" class="nav-button">
          <span data-translate="telegram-btn">написати в Telegram</span>
          <svg class="icon"><use href="#telegram"></use></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Херо (варіант В): слоган унизу фото + факти, що знімають сумнів «чи варто» і «де це» -->
  <section class="hero hero-trust">
    <div class="hero-trust-content">
      <h1 class="hero-title hero-trust-title" data-translate="hero-title">Час бути собою</h1>
      <div class="hero-trust-side">
        <div class="hero-trust-facts">
          @if (Model.Reviews.Rating is double heroRating && Model.Reviews.TotalCount is int heroTotal)
          {
            var heroCount = IndexModel.ReviewsCountLabel(heroTotal);
            <a class="hero-trust-rating" href="@Model.Reviews.ProfileUrl" target="_blank" rel="noopener">
              <b>@heroRating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</b>
              <span class="hero-trust-stars" aria-hidden="true">★★★★★</span>
              <span>@heroTotal <span data-translate="@heroCount.Key">@heroCount.Label</span></span>
            </a>
          }
          <p data-translate="footer-address">@Model.Salon.Address</p>
          @foreach (var line in Model.Schedule)
          {
            <p><span data-translate="@line.TranslateKey">@line.Days</span> @line.Time</p>
          }
        </div>
        <div class="hero-buttons hero-trust-buttons">
          <a href="@Model.BookingUrl" target="_blank" class="first-button" data-translate="hero-book">Записатися</a>
          <a href="#price" class="second-button" data-translate="hero-prices">Ціни</a>
        </div>
      </div>
    </div>
  </section>
</header>

<section class="services" id="services">
  <h2 class="services-title" data-translate="services-title">ПОСЛУГИ</h2>
  @* Картки з Content/service-photos.json; клік відкриває фото послуги у форматі сторіз *@
  <ul class="services-lisl">
    @for (var i = 0; i < Model.ServicePhotos.Count; i++)
    {
      var cat = Model.ServicePhotos[i];
      <li class="services-item">
        <button type="button" class="services-open" data-story-index="@i" aria-label="@cat.Title: @cat.Photos.Count фото">
          <responsive-img src="@cat.Cover" alt="@cat.Title" sizes="(max-width:767px) 100vw, 20vw" />
          <span class="services-count" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="14" height="14" rx="2" /><path d="M7 3h12a2 2 0 0 1 2 2v12" /></svg>@cat.Photos.Count
          </span>
          <span class="services-text" data-translate="@cat.TitleKey">@cat.Title</span>
        </button>
      </li>
    }
  </ul>
  <partial name="_ServiceStories" model="Model" />
  <a href="@Model.BookingUrl" target="_blank" class="services-btn" data-translate="hero-book">Записатися</a>
</section>

<section class="about" id="about">
  <div class="about-container">
    <h2 class="about-logo about-logo-title" data-translate="about-title">ПРО НАС</h2>
    <div class="about-text-container">
      <p class="about-text about-text-desktop" data-translate="about-text-desktop">
        Я створив місце, де зібрав усе, що люблю і вмію. Хочу зробити
        найкращу перукарню в Києві, і вкладаю в цей проєкт 101% себе. Це
        місце, де можна стати щасливішим. За годину (а з фарбуванням і за
        4-7 годин) можна змінити не просто зачіску, а настрій людини. У нас
        класна музика, затишна атмосфера, смачна кава – все, щоб ти
        почувався комфортно. Люблю динамічні стрижки та експерименти. Мій
        досвід дозволяє створювати форму, яка природно виглядає та гарно
        відростає. Волосся – це не просто стрижка, а частина образу, яка
        потребує уваги. Тому догляд, стайлінг і сушка феном – must-have, щоб
        розкрити його потенціал.
      </p>
      <p class="about-text about-text-mobile" data-translate="about-text-mobile">
        Я створив місце, де зібрав усе, що люблю і вмію. Хочу зробити
        найкращу перукарню в Києві, і вкладаю в цей проєкт 101% себе. Це
        місце, де можна стати щасливішим. За годину (а з фарбуванням і за
        4-7 годин) можна змінити не просто зачіску, а настрій людини. У нас
        класна музика, затишна атмосфера, смачна кава – все, щоб ти
        почувався комфортно. Люблю динамічні стрижки та експерименти. Мій
        досвід дозволяє створювати форму, яка природно виглядає та гарно
        відростає.
      </p>
      <div class="about-author">
        <img src="~/img/avatar.png" alt="Фото Валентина" class="author-avatar" />
        <div class="about-author-info">
          <p class="author-name" data-translate="author-name">Валентин Галицький</p>
          <p class="author-role" data-translate="author-role">Засновник Перукарні Валентина</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="cosmetics">
  <div class="cosmetics-container">
    <div class="cosmetics-text">
      <h2 class="cosmetics-title" data-translate="cosmetics-title">Косметика, яку ми використовуємо</h2>
      <p class="cosmetics-description" data-translate="cosmetics-description">
        Засоби для догляду за волоссям пропонують індивідуальну систему
        догляду, створену спеціально для вас. Використовуючи натуральні
        інгредієнти, науково доведено, що ця преміальна лінія забезпечує
        найкращий догляд за вашим волоссям. ми надаємо професійні
        рекомендації щодо догляду за волоссям, допомагаючи вам обрати
        ідеальні засоби, які відповідають вашому типу та стилю волосся
      </p>
    </div>
    <div class="cosmetics-slider">
      <div class="cosmetics-scroll js-scroller" data-autoplay="4000">
        @for (var i = 1; i <= 5; i++)
        {
          <responsive-img src="@($"img/cosmetics-{i}")" alt="Косметика Keune, яку ми використовуємо" img-class="cosmetics-photo" sizes="(max-width:767px) 80vw, 300px" />
        }
      </div>
      <div class="scroller-dots" aria-hidden="true"></div>
    </div>
  </div>
</section>

<section class="gallery" id="gallery">
  <h2 class="gallery-title" data-translate="gallery-title">ГАЛЕРЕЯ РОБІТ</h2>
  <div class="gallery-container">
    <div class="gallery-desktop">
      <div class="gallery-slider">
        <button class="gallery-nav-btn gallery-prev" aria-label="Previous">&#8249;</button>
        <div class="gallery-scroll-container">
          <div class="gallery-slide active">
            <img src="~/img/gallery 11.jpg" alt="gallery" class="gallery-desktop-image" />
            <img src="~/img/gallery 2.jpg" alt="gallery" class="gallery-desktop-image" />
            <responsive-img src="img/gallery 3" alt="gallery" img-class="gallery-desktop-image" sizes="(max-width:767px) 50vw, 25vw" />
            <img src="~/img/gallery 4.jpg" alt="gallery" class="gallery-desktop-image" />
          </div>
          <div class="gallery-slide">
            <img src="~/img/gallery 5.png" alt="gallery" class="gallery-desktop-image" />
            <img src="~/img/gallery 6.png" alt="gallery" class="gallery-desktop-image" />
            <img src="~/img/gallery 7.jpg" alt="gallery" class="gallery-desktop-image" />
            <responsive-img src="img/gallery 8" alt="gallery" img-class="gallery-desktop-image" sizes="(max-width:767px) 50vw, 25vw" />
          </div>
        </div>
        <button class="gallery-nav-btn gallery-next" aria-label="Next">&#8250;</button>
      </div>
      <div class="gallery-indicators">
        <button class="gallery-indicator active" data-slide="0"></button>
        <button class="gallery-indicator" data-slide="1"></button>
      </div>
    </div>

    <div class="gallery-mobile">
      <div class="gallery-mobile-scroll-container js-scroller" data-autoplay="4000">
        <img src="~/img/gallery 11.jpg" alt="gallery" class="gallery-mobile-image" />
        <img src="~/img/gallery 2.jpg" alt="gallery" class="gallery-mobile-image" />
        <responsive-img src="img/gallery 3" alt="gallery" img-class="gallery-mobile-image" sizes="50vw" />
        <img src="~/img/gallery 4.jpg" alt="gallery" class="gallery-mobile-image" />
        <img src="~/img/gallery 5.png" alt="gallery" class="gallery-mobile-image" />
        <img src="~/img/gallery 6.png" alt="gallery" class="gallery-mobile-image" />
        <img src="~/img/gallery 7.jpg" alt="gallery" class="gallery-mobile-image" />
        <responsive-img src="img/gallery 8" alt="gallery" img-class="gallery-mobile-image" sizes="50vw" />
      </div>
      <div class="scroller-dots" aria-hidden="true"></div>
    </div>

    <a href="https://www.instagram.com/valentyna_perukarnia/" class="gallery-link" target="_blank" rel="noopener noreferrer">
      <span data-translate="gallery-more">Більше фото в Instagram</span>
      <svg class="gallery-icon"><use href="#instagram"></use></svg>
    </a>
  </div>

  <div class="lightbox-modal" id="lightbox-modal">
    <div class="lightbox-content">
      <button class="lightbox-close" id="lightbox-close">&times;</button>
      <img class="lightbox-image" id="lightbox-image" src="" alt="Gallery image" />
      <button class="lightbox-nav lightbox-prev" id="lightbox-prev">&#8249;</button>
      <button class="lightbox-nav lightbox-next" id="lightbox-next">&#8250;</button>
    </div>
  </div>
</section>

<section class="price" id="price">
  <div class="price-container">
    <h2 class="price-title" data-translate="price-title">ПОСЛУГИ ТА ЦІНИ</h2>
    <p class="price-description" data-translate="price-description">
      Ми Перукарня Валентина. Інклюзивна перукарня, де є місце для кожного. Місцева перукарня, що робить стиль без меж.
    </p>
    <div class="price-cards js-scroller">
      @foreach (var category in Model.ServiceCategories)
      {
        <div class="@category.CssClass">
          <div class="price-item-title-container">
            <svg class="price-icon"><use href="#price-item-icon" class="price-icon-svg"></use></svg>
            <p class="price-item-title" data-translate="@category.TranslateKey">@category.Name</p>
          </div>
          <ul class="price-list">
            @foreach (var service in category.Services)
            {
              <li class="@category.RowCssClass">
                @if (service.IsGroupHeader)
                {
                  <p class="service-name-group" data-translate="@service.TranslateKey">@service.Name</p>
                }
                else
                {
                  <span class="service-name" data-translate="@service.TranslateKey">@service.Name</span>
                  @if (service.PriceTranslateKey != null)
                  {
                    <span class="service-price" data-translate="@service.PriceTranslateKey">@service.PriceDisplay</span>
                  }
                  else if (service.PriceFrom)
                  {
                    <span class="service-price"><span data-translate="from-price">Від</span> @service.PriceDisplay</span>
                  }
                  else
                  {
                    <span class="service-price">@service.PriceDisplay</span>
                  }
                }
              </li>
            }
          </ul>
        </div>
      }
    </div>
    <div class="scroller-dots price-dots" aria-hidden="true"></div>
    <a href="@Model.BookingUrl" target="_blank" class="price-button" data-translate="hero-book">Записатися</a>
  </div>
</section>

<section class="news">
  <div class="news-container">
    <h2 class="news-title" data-translate="news-title">ПОДІЇ ТА НОВИНИ</h2>
    <p class="news-subtitle" data-translate="news-subtitle">
      Завітайте до нас на цікаві події та користуйтесь акційними пропозиціями
    </p>
    <h3 class="news-group-title" data-translate="news-upcoming">НАЙБЛИЖЧІ ПОДІЇ</h3>
    @if (Model.UpcomingNews.Count > 0)
    {
      <div class="news-scroll-container js-scroller" data-autoplay="5000">
        @foreach (var item in Model.UpcomingNews)
        {
          <partial name="_NewsCard" model="item" />
        }
      </div>
      <div class="scroller-dots" aria-hidden="true"></div>
    }
    else
    {
      <p class="news-empty">
        <span data-translate="news-empty">Нові події вже готуємо — стежте за анонсами в Instagram</span>
        <a href="https://www.instagram.com/valentyna_perukarnia/" target="_blank" rel="noopener noreferrer">@@valentyna_perukarnia</a>
      </p>
    }

    @if (Model.PastNews.Count > 0)
    {
      <h3 class="news-group-title" data-translate="news-past">МИНУЛІ ПОДІЇ</h3>
      <div class="news-scroll-container js-scroller" data-autoplay="5000">
        @foreach (var item in Model.PastNews)
        {
          <partial name="_NewsCard" model="item" />
        }
      </div>
      <div class="scroller-dots" aria-hidden="true"></div>
    }
  </div>
</section>

<section class="section-picture">
  <div class="section-img"></div>
</section>

<section class="reviews">
  <div class="reviews-container">
    <h2 class="reviews-title" data-translate="reviews-title">ВІДГУКИ НАШИХ КЛІЄНТІВ</h2>
    <p class="reviews-subtitle" data-translate="reviews-subtitle">
      Зазирніть у наше портфоліо вражаючих перевтілень та знайдіть натхнення
      для свого нового образу
    </p>
    <p class="reviews-subtitle-tablet" data-translate="reviews-subtitle-tablet">
      Наші клієнти – наш головний пріоритет! Довіра, якість та стиль – те,
      що ми створюємо разом. Ознайомтесь із враженнями наших гостей і
      приєднуйтесь до спільноти задоволених клієнтів
    </p>
    @if (Model.Reviews.Rating is double rating && Model.Reviews.TotalCount is int total)
    {
      var countLabel = IndexModel.ReviewsCountLabel(total);
      <a class="reviews-summary" href="@Model.Reviews.ProfileUrl" target="_blank" rel="noopener">
        <span class="reviews-summary-rating">@rating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)</span>
        <span class="reviews-summary-stars" aria-hidden="true">★★★★★</span>
        <span>@total <span data-translate="@countLabel.Key">@countLabel.Label</span></span>
      </a>
    }
    <div class="reviews-cards">
      @foreach (var review in Model.Reviews.Reviews)
      {
        <div class="review-card" data-lang="@review.Language" hidden="@(review.Language == "en")">
          <div class="review-header">
            @if (!string.IsNullOrEmpty(review.AvatarUrl))
            {
              <img src="@Url.Content(review.AvatarUrl)" alt="" class="review-avatar" width="60" height="60" loading="lazy" referrerpolicy="no-referrer" />
            }
            else
            {
              <span class="review-avatar review-avatar-initial" aria-hidden="true">@(review.AuthorName.Length > 0 ? review.AuthorName[..1].ToUpperInvariant() : "?")</span>
            }
            <div class="review-info">
              @if (!string.IsNullOrEmpty(review.AuthorUrl))
              {
                <a class="review-name" href="@review.AuthorUrl" target="_blank" rel="noopener nofollow">@review.AuthorName</a>
              }
              else
              {
                <p class="review-name">@review.AuthorName</p>
              }
              @if (review.Rating >= 5)
              {
                <img src="~/img/stars.png" alt="5/5" class="review-stars" />
              }
              else
              {
                <span class="review-stars-text" aria-label="@review.Rating/5">@(new string('★', review.Rating) + new string('☆', 5 - review.Rating))</span>
              }
              @if (!string.IsNullOrEmpty(review.RelativeDate))
              {
                <time class="review-date" datetime="@review.PublishedAt?.ToString("o")">@review.RelativeDate</time>
              }
            </div>
          </div>
          <p class="review-text">@review.Text</p>
          @if (!string.IsNullOrEmpty(review.GoogleUrl))
          {
            <a class="review-more" href="@review.GoogleUrl" target="_blank" rel="noopener" data-translate="reviews-read-more">Читати на Google</a>
          }
        </div>
      }
    </div>
  </div>
  <div class="reviews-dots">
    @{ var firstDot = true; }
    @foreach (var review in Model.Reviews.Reviews)
    {
      var active = firstDot && review.Language != "en";
      if (active) { firstDot = false; }
      <span class="dot-review@(active ? " active" : "")" data-lang="@review.Language" hidden="@(review.Language == "en")"></span>
    }
  </div>
</section>

<footer class="footer" id="booking">
  <div class="footer-container">
    <div class="footer-bottom">
      <div class="footer-column">
        <h2 class="footer-title" data-translate="footer-title">Перукарня Валентина</h2>
        <p class="footer-text left" data-translate="footer-text">
          Створюємо стиль, який підкреслює вашу індивідуальність. Наша
          команда професіоналів допоможе вам знайти ідеальний образ.
        </p>
      </div>
      <div class="footer-column">
        <h2 class="footer-title" data-translate="footer-links-title">Швидкі посилання</h2>
        <ul class="footer-links">
          <li><a href="#" class="footer-link" data-translate="nav-home">Головна</a></li>
          <li><a href="#" class="footer-link" data-translate="nav-about">Про нас</a></li>
          <li><a href="#" class="footer-link" data-translate="nav-price">Прайс</a></li>
          <li><a href="#" class="footer-link" data-translate="nav-gallery">Галерея</a></li>
          <li><a href="#" class="footer-link" data-translate="reviews-title">Відгуки</a></li>
        </ul>
      </div>
      <div class="footer-column">
        <h2 class="footer-title" data-translate="footer-schedule-title">Графік роботи</h2>
        @foreach (var line in Model.Schedule)
        {
          <p class="footer-text"><span data-translate="@line.TranslateKey">@line.Days</span> @line.Time</p>
        }
      </div>
    </div>

    <div class="footer-top-container">
      <div class="footer-top-container-info">
        <div class="footer-column">
          <h2 class="footer-link-title" data-translate="footer-social-title">Ми в соцмережах</h2>
