@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    // GTM лише в Production, щоб локальні/тестові запуски не псували статистику.
    // Container ID не секрет — він і так видно в HTML сторінки.
    var gtmContainerId = Configuration["Analytics:GtmContainerId"];
}
@if (Env.IsProduction() && !string.IsNullOrWhiteSpace(gtmContainerId))
{
    @* Google Tag Manager — єдине місце для тегів: GA4 (G-Q91M0KFBY2), реклама і конверсії налаштовує маркетинг у GTM.
       Окремий gtag.js на сайті не ставимо, інакше перегляди в GA4 рахуються двічі. *@
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','@gtmContainerId');</script>
}
